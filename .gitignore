# Secrets: never commit these
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.ruff_cache/

# OS / editor
.DS_Store
.vscode/
.idea/

# Data: raw files may contain personal details, review before adding any
data/raw/*
!data/raw/.gitkeep

# Local test data tool: fake data must never be committed (real data only)
backend/local_test_data.py
backend/local_test_photos/

# Consent records for real data: kept outside the repository (see data/sources.md)
data/consent/

# Uploaded car photos, if a local folder is ever used instead of the Docker volume
uploads/

# The server's own copy of nginx/https.conf.example with its domain filled in
nginx/https.conf
