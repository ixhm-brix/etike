# Copy to .env and fill in. Never commit the real .env file.

# development locally, production on the VPS
FLASK_ENV=development

# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Signs login tokens. Use a different random value from SECRET_KEY, made the same way.
JWT_SECRET_KEY=change-me

# Database container settings
POSTGRES_USER=etike
POSTGRES_PASSWORD=change-me
POSTGRES_DB=etike

# The API reads this. Host "db" is the database container name.
DATABASE_URL=postgresql+psycopg://etike:change-me@db:5432/etike

# Optional: separate database used by tests (defaults to in-memory SQLite)
# TEST_DATABASE_URL=postgresql+psycopg://etike:change-me@localhost:5432/etike_test

# Production only: Nginx config. default.conf (HTTP) until the Let's Encrypt
# certificate exists, then https.conf (see docs/deployment.md, step 6).
# NGINX_CONF=default.conf

# Optional: Gunicorn worker count in production
# GUNICORN_WORKERS=3

# "Try it with a test account" buttons on the login page (log in to TEST
# accounts without a password). Never true on a public server.
DEMO_LOGIN=false

# Bus booking is a future phase. Leave off (false); true shows bus trips again.
FEATURE_BUS_BOOKING=false

# How many minutes an unpaid booking holds its seats (default 15)
# BOOKING_HOLD_MINUTES=15

# A confirmed booking can be cancelled until this many hours before departure (default 2)
# CANCEL_CUTOFF_HOURS=2

# Other sites allowed to call the API from a browser, comma separated.
# Leave empty in production: our own pages use the same domain and need no
# CORS, so empty means no other site can call the API from a browser.
# CORS_ORIGINS=

# MTN MoMo Collections API (request to pay). Sandbox: https://momodeveloper.mtn.com
# Global sandbox: https://sandbox.momodeveloper.mtn.com with "sandbox".
# Production: MTN Rwanda's live address with "mtnrwanda".
MOMO_BASE_URL=
MOMO_TARGET_ENVIRONMENT=
# Primary key of the Collections product, from your profile on the MoMo developer site.
MOMO_SUBSCRIPTION_KEY=
# Sandbox: create these two with
#   docker compose exec api flask --app wsgi momo-create-user
MOMO_API_USER=
MOMO_API_KEY=
# EUR in the sandbox (it accepts nothing else), RWF in production.
MOMO_CURRENCY=
# Optional: address MoMo calls when a payment finishes,
# e.g. https://YOUR_DOMAIN/api/payments/callback
MOMO_CALLBACK_URL=

# Africa's Talking SMS. Use AT_USERNAME=sandbox with the sandbox API key to test.
AT_USERNAME=
AT_API_KEY=
# Optional registered sender ID; leave empty to use the default.
AT_SENDER_ID=

# Only used once, by `flask create-admin` (it asks for anything left empty).
# Remove them from .env after creating the admin.
# ADMIN_NAME=
# ADMIN_PHONE=
# ADMIN_PASSWORD=
