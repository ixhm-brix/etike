# Copy to .env and fill in. Never commit the real .env file.

# development locally, production on the VPS
FLASK_ENV=development

# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Signs login tokens. Use a different random value from SECRET_KEY, made the same way.
JWT_SECRET_KEY=change-me

# Database container settings
POSTGRES_USER=etike
POSTGRES_PASSWORD=change-me
POSTGRES_DB=etike

# The API reads this. Host "db" is the database container name.
DATABASE_URL=postgresql+psycopg://etike:change-me@db:5432/etike

# Optional: separate database used by tests (defaults to in-memory SQLite)
# TEST_DATABASE_URL=postgresql+psycopg://etike:change-me@localhost:5432/etike_test

# Optional: Gunicorn worker count in production
# GUNICORN_WORKERS=3

# How many minutes an unpaid booking holds its seats (default 15)
# BOOKING_HOLD_MINUTES=15

# Other sites allowed to call the API from a browser, comma separated.
# Leave empty: our own pages use the same domain and need no CORS.
# CORS_ORIGINS=

# Flutterwave (Rwanda mobile money). Use TEST keys (FLWSECK_TEST-...) until launch.
# Dashboard: Settings > API keys, and Settings > Webhooks for the secret hash.
FLW_SECRET_KEY=
# Any long random text; enter the same value in the dashboard's webhook settings.
FLW_SECRET_HASH=
# Page the customer returns to after paying, e.g. https://YOUR_DOMAIN/payment.html
FLW_REDIRECT_URL=
# FLW_BASE_URL=https://api.flutterwave.com

# Africa's Talking SMS. Use AT_USERNAME=sandbox with the sandbox API key to test.
AT_USERNAME=
AT_API_KEY=
# Optional registered sender ID; leave empty to use the default.
AT_SENDER_ID=

# Only used once, by `flask create-admin` (it asks for anything left empty).
# Remove them from .env after creating the admin.
# ADMIN_NAME=
# ADMIN_PHONE=
# ADMIN_PASSWORD=
